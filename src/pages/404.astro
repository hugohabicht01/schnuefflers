---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../data/site';

Astro.response.status = 404;
---

<BaseLayout
  lang="de"
  page="home"
  title="Seite nicht gefunden | Schnüffler’s Dalmatiner"
  description="Die gesuchte Seite wurde nicht gefunden."
  noindex={true}
  canonicalPath="/404.html"
  includeAlternates={false}
>
  <section class="page-intro shell">
    <div class="page-number" aria-hidden="true">404</div>
    <div class="page-title-block">
      <p class="eyebrow">Nicht gefunden · Not found</p>
      <h1>Diese Spur endet hier.</h1>
    </div>
    <div class="page-lead">
      <p>Die gesuchte Seite gibt es nicht oder sie wurde verschoben.</p>
      <p lang="en">The page you were looking for does not exist or has moved.</p>
      <a class="button-link" href={routes.de.home}>Zur Startseite</a>
    </div>
  </section>
</BaseLayout>
