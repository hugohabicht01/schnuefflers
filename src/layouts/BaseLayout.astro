---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import heroImage from '../assets/puenktchen-mountains.jpg';
import { routes, site, ui, type Lang, type PageKey } from '../data/site';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  includeAlternates?: boolean;
}

const { lang, page, title, description, noindex = false, canonicalPath, includeAlternates = true } = Astro.props;
const canonical = new URL(canonicalPath ?? routes[lang][page], Astro.site);
const germanUrl = new URL(routes.de[page], Astro.site);
const englishUrl = new URL(routes.en[page], Astro.site);
const socialImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 88,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: 'https://schnuefflers.de',
  email: site.email,
  sameAs: [site.instagram],
  founder: {
    '@type': 'Person',
    name: site.owner,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: 'DE',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {includeAlternates && <link rel="alternate" hreflang="de" href={germanUrl} />}
    {includeAlternates && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {includeAlternates && <link rel="alternate" hreflang="x-default" href={germanUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'de' ? 'Pünktchen vor einer Berglandschaft' : 'Pünktchen in front of a mountain landscape'} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#content">{ui[lang].skip}</a>
    <Header lang={lang} page={page} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
