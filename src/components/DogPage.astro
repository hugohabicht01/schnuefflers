---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import standingImage from '../assets/puenktchen-standing.jpg';
import portraitImage from '../assets/puenktchen-portrait.jpg';
import forestImage from '../assets/puenktchen-forest-profile.jpg';
import runningImage from '../assets/puenktchen-running.jpg';
import hatImage from '../assets/puenktchen-hat.jpg';
import { type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'de' ? {
  title: 'Pünktchen | Schnüffler’s Dalmatiner',
  description: 'Alles über Pünktchen, offiziell Bacardi Feeling Canadian Amethyst: LUA-Dalmatinerhündin, geboren am 2. Dezember 2023 und zur Zucht zugelassen.',
  eyebrow: 'Unsere Hündin',
  heading: 'Pünktchen',
  lead: 'Bacardi Feeling Canadian Amethyst ist der Mittelpunkt von Schnüffler’s: eine freundliche, soziale und ausgeglichene LUA-Dalmatinerhündin.',
  factsTitle: 'Steckbrief',
  facts: [
    ['Zuchtname', 'Bacardi Feeling Canadian Amethyst'],
    ['Rufname', 'Pünktchen'],
    ['Geboren', '02.12.2023'],
    ['Zuchtbuchnummer', 'VDH/CDF-6454L/23'],
    ['Farbe', 'Weiß-schwarz'],
    ['Besonderheit', 'Innenohrplatte rechts'],
    ['LUA-Status', 'N/hu'],
    ['Gehör', 'Beidseitig hörend'],
    ['Mutter', 'Oesel’s Bezaubernde Berta'],
    ['Vater', 'Spavinaw CK Hear UR Make NN Waves @ Echoview'],
  ],
  natureTitle: 'Ruhig zu Hause. Voller Energie draußen.',
  natureText: ['Pünktchen ist unglaublich freundlich und sozial. Im Haus ist sie ruhig und ausgeglichen; draußen zeigt sie, wie viel Bewegung in einem Dalmatiner steckt.', 'Jeden Tag verbringt sie ein bis zwei Stunden auf den großen Feldern bei ihrem Zuhause. Dort kann sie laufen, spielen und andere Hunde treffen. Für Cosima ist diese tägliche Bewegung kein Extra, sondern ein wesentlicher Teil eines guten Dalmatinerlebens.'],
  approvalTitle: 'Zuchtzulassung',
  approvalText: 'Pünktchen hat ihre Zuchtzulassung im CDF / VDH erhalten. Ihre freundliche Art, ihre Gesundheit und ihr Erscheinungsbild haben Cosima darin bestärkt, ihre Linie verantwortungsvoll fortführen zu wollen.',
  pedigree: 'Pedigree ansehen',
  breeder: 'Zur Zuchtstätte Bacardi Feeling',
  gallery: 'Pünktchen im Alltag',
  captions: ['Aufmerksam und gelassen', 'Unterwegs im Wald', 'Bewegung gehört jeden Tag dazu', 'Auch ruhige Momente dürfen verspielt sein'],
} : {
  title: 'Pünktchen | Schnüffler’s Dalmatians',
  description: 'Meet Pünktchen, officially Bacardi Feeling Canadian Amethyst: an LUA Dalmatian born on 2 December 2023 and approved for breeding.',
  eyebrow: 'Our Dalmatian',
  heading: 'Pünktchen',
  lead: 'Bacardi Feeling Canadian Amethyst is at the heart of Schnüffler’s: a friendly, social and even-tempered LUA Dalmatian.',
  factsTitle: 'Profile',
  facts: [
    ['Registered name', 'Bacardi Feeling Canadian Amethyst'],
    ['Call name', 'Pünktchen'],
    ['Born', '2 December 2023'],
    ['Registration', 'VDH/CDF-6454L/23'],
    ['Colour', 'White and black'],
    ['Marking', 'Right inner-ear patch'],
    ['LUA status', 'N/hu'],
    ['Hearing', 'Bilaterally hearing'],
    ['Dam', 'Oesel’s Bezaubernde Berta'],
    ['Sire', 'Spavinaw CK Hear UR Make NN Waves @ Echoview'],
  ],
  natureTitle: 'Calm at home. Full of energy outdoors.',
  natureText: ['Pünktchen is exceptionally friendly and social. She is calm and settled at home; outside, she shows just how much movement a Dalmatian needs.', 'Every day she spends one to two hours in the large fields near home, where she can run, play and meet other dogs. For Cosima, this daily exercise is not an optional extra but an essential part of a good life for a Dalmatian.'],
  approvalTitle: 'Breeding approval',
  approvalText: 'Pünktchen has received her breeding approval within the CDF / VDH. Her friendly nature, health and appearance have strengthened Cosima’s wish to continue her line responsibly.',
  pedigree: 'View pedigree',
  breeder: 'Visit Bacardi Feeling',
  gallery: 'Everyday life with Pünktchen',
  captions: ['Attentive and composed', 'Out in the woods', 'Exercise is part of every day', 'Quiet moments can be playful too'],
};

const gallery = [portraitImage, forestImage, runningImage, hatImage];
---

<BaseLayout lang={lang} page="dog" title={c.title} description={c.description}>
  <PageIntro number="02" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />
  <section class="profile-grid">
    <div class="profile-image">
      <Image src={standingImage} alt={lang === 'de' ? 'Pünktchen im Stand auf einer Wiese' : 'Pünktchen standing in a meadow'} widths={[640, 900, 1200, 1600]} sizes="(max-width: 900px) 100vw, 60vw" format="avif" />
    </div>
    <div class="profile-facts">
      <h2>{c.factsTitle}</h2>
      <dl class="definition-list">
        {c.facts.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="body-grid shell">
    <h2>{c.natureTitle}</h2>
    <div class="body-copy">
      {c.natureText.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="body-grid shell">
    <h2>{c.approvalTitle}</h2>
    <div class="body-copy">
      <p>{c.approvalText}</p>
      <div class="link-row">
        <a class="text-link" href="https://dogs.pedigreeonline.com/bacardi-feeling-canadian-amethyst-lua-VWZtUmeG/pedigree" target="_blank" rel="noopener">{c.pedigree}</a>
        <a class="text-link" href="https://www.bacardi-feeling.de/zucht-1/c-wurf/" target="_blank" rel="noopener">{c.breeder}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="gallery-heading">
    <div class="shell" style="padding-top: 4rem; padding-bottom: 2rem"><p class="eyebrow" id="gallery-heading">{c.gallery}</p></div>
    <div class="gallery-grid">
      {gallery.map((image, index) => (
        <figure class={index < 2 ? 'portrait' : ''}>
          <Image src={image} alt={c.captions[index]} widths={[640, 960, 1280]} sizes="(max-width: 600px) 100vw, 50vw" format="avif" />
          <figcaption>{c.captions[index]}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
