---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import forestImage from '../assets/puenktchen-forest-profile.jpg';
import spotsImage from '../assets/puenktchen-spots.jpg';
import { routes, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'de' ? {
  title: 'Zucht & A-Wurf 2027 | Schnüffler’s Dalmatiner',
  description: 'Ich plane den ersten Dalmatinerwurf von Schnüffler’s für Sommer 2027. Meine Schwerpunkte sind Gesundheit, Wesen, Bewegung und genetische Vielfalt.',
  eyebrow: 'Zucht im CDF / VDH',
  heading: 'Sorgfalt vor Tempo.',
  lead: 'Meinen ersten Wurf plane ich für den Sommer 2027. Bis dahin zählt für mich jeder Schritt der Vorbereitung.',
  planEyebrow: 'A-Wurf · Sommer 2027',
  planTitle: 'Eine Planung, kein Versprechen.',
  planText: ['Zucht lässt sich nicht vollständig terminieren. Der Sommer 2027 ist mein angestrebter Zeitraum, sofern Gesundheit, Zyklus, tierärztliche Begleitung und eine passende Verpaarung zusammenkommen.', 'Details zum Rüden und zur konkreten Verpaarung veröffentliche ich erst, wenn meine Entscheidung fundiert getroffen und die Planung verbindlicher ist.'],
  pillarsEyebrow: 'Züchterische Grundlage',
  pillars: [
    ['Gesundheit', 'Meine züchterische Grundlage ist transparent dokumentiert: LUA N/hu, HD B, ED 0, ARDS-, LSD- und PRKG2-frei sowie vollzahnig mit korrektem Scherengebiss.'],
    ['Genetische Vielfalt', 'Pünktchens 8-Generationen-COI liegt bei 0,0084 %. In neun Generationen sind 592 von 1.023 Vorfahren einzigartig. Diese Vielfalt beziehe ich bewusst in jede Verpaarung ein.'],
    ['Wesen', 'Ich achte auf Freundlichkeit, Sozialverhalten und Alltagstauglichkeit. Pünktchens ruhige Art zu Hause und ihr liebevoller Umgang mit Welpen und Junghunden sind dafür ein starkes Fundament.'],
  ],
  exerciseTitle: 'Ein sportlicher Hund braucht einen passenden Alltag.',
  exerciseText: ['Dalmatiner sind aktive, ausdauernde Hunde. Ohne ausreichende Bewegung und Beschäftigung können sie unausgeglichen werden. Mit Pünktchen bin ich täglich ein bis zwei Stunden im Feld unterwegs; dort trifft sie regelmäßig andere Hunde.', 'Diese Erfahrung prägt meine Vorstellung davon, was ein gutes Zuhause für einen Dalmatiner leisten sollte: verlässliche Zeit, Freude an Bewegung und echtes Interesse an einem sozialen Familienhund.'],
  interestTitle: 'Interesse am A-Wurf?',
  interestText: 'Ich freue mich über frühen Kontakt. Ein Kennenlernen ist unverbindlich und gibt uns Raum, Erwartungen, Alltag und die Bedürfnisse eines Dalmatiners offen zu besprechen.',
  interestLink: 'Kontakt aufnehmen',
} : {
  title: 'Breeding & first litter 2027 | Schnüffler’s Dalmatians',
  description: 'I am planning Schnüffler’s first Dalmatian litter for summer 2027. My priorities are health, temperament, exercise and genetic diversity.',
  eyebrow: 'Breeding within CDF / VDH',
  heading: 'Care before speed.',
  lead: 'I am planning my first litter for summer 2027. Until then, every step of the preparation matters to me.',
  planEyebrow: 'First litter · Summer 2027',
  planTitle: 'A plan, not a promise.',
  planText: ['Breeding cannot be scheduled with complete certainty. Summer 2027 is my intended timeframe, provided that health, Pünktchen’s cycle, veterinary guidance and a suitable pairing all align.', 'I will publish details of the sire and the specific pairing only when I have made a carefully considered decision and the plan is more definite.'],
  pillarsEyebrow: 'Breeding foundation',
  pillars: [
    ['Health', 'My breeding foundation is transparently documented: LUA N/hu, HD B, ED 0, clear of ARDS, LSD and PRKG2, with complete dentition and a correct scissor bite.'],
    ['Genetic diversity', 'Pünktchen’s eight-generation COI is 0.0084%. Across nine generations, 592 of 1,023 ancestors are unique. I will consciously consider this diversity in every pairing.'],
    ['Temperament', 'I value friendliness, sociability and suitability for everyday life. Pünktchen’s calm nature at home and gentle way with puppies and young dogs provide a strong foundation.'],
  ],
  exerciseTitle: 'An athletic dog needs the right daily life.',
  exerciseText: ['Dalmatians are active and enduring dogs. Without sufficient exercise and stimulation, they can become unsettled. I spend one to two hours in the fields with Pünktchen every day, where she regularly meets other dogs.', 'This experience shapes my idea of a suitable Dalmatian home: dependable time, a genuine enjoyment of exercise and real interest in a social family dog.'],
  interestTitle: 'Interested in the first litter?',
  interestText: 'I welcome early contact. An initial conversation is without obligation and gives us a chance to discuss expectations, daily life and the needs of a Dalmatian openly.',
  interestLink: 'Get in touch',
};
---

<BaseLayout lang={lang} page="breeding" title={c.title} description={c.description}>
  <PageIntro number="04" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />

  <section class="future-band">
    <div class="future-copy">
      <p class="eyebrow" style="color: currentColor">{c.planEyebrow}</p>
      <h2>{c.planTitle}</h2>
      {c.planText.map((p) => <p>{p}</p>)}
    </div>
    <div class="future-year" aria-label="2027">2027</div>
  </section>

  <section>
    <div class="shell" style="padding-top: 4rem; padding-bottom: 2rem"><p class="eyebrow">{c.pillarsEyebrow}</p></div>
    <div class="values-grid">
      {c.pillars.map(([title, text], index) => <article class="value-card"><span class="number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>

  <section class="dog-feature">
    <div class="dog-feature-image">
      <Image src={forestImage} alt={lang === 'de' ? 'Pünktchen mit aufmerksamem Blick im Wald' : 'Pünktchen looking attentively in the woods'} widths={[640, 900, 1200]} sizes="(max-width: 900px) 100vw, 55vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <h2>{c.exerciseTitle}</h2>
      <div>{c.exerciseText.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="profile-grid">
    <div class="profile-image">
      <Image src={spotsImage} alt={lang === 'de' ? 'Pünktchens Fell vor einem gepunkteten Hintergrund' : 'Pünktchen’s coat against a spotted background'} widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 60vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <div><p class="eyebrow">{lang === 'de' ? 'Unverbindliches Kennenlernen' : 'An initial conversation'}</p><h2>{c.interestTitle}</h2></div>
      <div><p>{c.interestText}</p><a class="button-link" href={routes[lang].contact}>{c.interestLink}</a></div>
    </div>
  </section>
</BaseLayout>
