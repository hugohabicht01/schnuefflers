---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/puenktchen-mountains.jpg';
import standingImage from '../assets/puenktchen-standing.jpg';
import { routes, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;

const content = lang === 'de' ? {
  title: 'Schnüffler’s Dalmatiner | Dalmatinerzucht im CDF / VDH',
  description: 'Schnüffler’s steht für verantwortungsvolle LUA-Dalmatinerzucht im CDF / VDH mit Fokus auf Gesundheit, Wesen und genetische Vielfalt. A-Wurf geplant für Sommer 2027.',
  heroEyebrow: 'Dalmatinerzucht · CDF / VDH',
  heroTitle: ['Gesundheit. Wesen.', 'Vielfalt.'],
  heroText: 'Mit Schnüffler’s möchte ich gesunde, wesensfeste und genetisch vielfältige Dalmatiner züchten. Jede Entscheidung treffe ich mit Blick auf ein langes, gutes Hundeleben.',
  heroLink: 'Meine Zucht kennenlernen',
  labels: ['Grundlage', 'Zuchtverband', 'Zuchtziel', 'Wurfplanung'],
  facts: ['Gesundheit & Wesen', 'CDF / VDH', 'LUA & Vielfalt', 'A-Wurf · 2027'],
  introEyebrow: 'Schnüffler’s Dalmatiner',
  introTitle: 'Verantwortungsvoll weiterdenken.',
  introText: 'Meine Zuchtplanung verbindet LUA, nachvollziehbare Gesundheitsdaten, genetische Vielfalt und ein alltagstaugliches Wesen. Pünktchen verkörpert diese Ziele und bildet die züchterische Grundlage des geplanten A-Wurfs.',
  dogEyebrow: 'Unsere Hunde · Zuchthündin',
  dogTitle: 'Pünktchen',
  dogText: 'Bacardi Feeling Canadian Amethyst stammt aus dem C-Wurf von Bacardi Feeling. Sie ist LUA N/hu, genetisch sehr vielfältig und zur Zucht im CDF / VDH zugelassen. Ihr offenes, soziales Wesen zeigt sie im Alltag ebenso wie im liebevollen Umgang mit Welpen und Junghunden.',
  dogLink: 'Pünktchens ausführliches Profil',
  futureEyebrow: 'Wurfplanung',
  futureTitle: 'Unser A-Wurf ist für den Sommer 2027 geplant.',
  futureText: 'Gesundheit, eine passende Verpaarung und eine verantwortungsvolle Vorbereitung haben Vorrang. Wer meine Zucht früh kennenlernen möchte, kann sich gern unverbindlich bei mir melden.',
  futureLink: 'Mehr zur Zuchtplanung',
  valuesEyebrow: 'Wofür meine Zucht steht',
  values: [
    ['Genetische Vielfalt', 'LUA-Genstatus, Abstammung und eine sorgfältige Auswahl jeder Verpaarung gehören für mich zu verantwortungsvoller Dalmatinerzucht.'],
    ['Wesen', 'Ich möchte freundliche, soziale und ausgeglichene Dalmatiner züchten, die ihre Menschen im Alltag zuverlässig begleiten.'],
    ['Lebensqualität', 'Bewegung, Beschäftigung und enger Familienanschluss sind für mich die Grundlage für ein ausgeglichenes Dalmatinerleben.'],
  ],
} : {
  title: 'Schnüffler’s Dalmatians | Breeding within CDF / VDH',
  description: 'Schnüffler’s stands for responsible LUA Dalmatian breeding within CDF / VDH, with a focus on health, temperament and genetic diversity. First litter planned for summer 2027.',
  heroEyebrow: 'Dalmatian breeding · CDF / VDH',
  heroTitle: ['Health. Temperament.', 'Diversity.'],
  heroText: 'Through Schnüffler’s, I aim to breed healthy, sound and genetically diverse Dalmatians. Every decision is guided by the prospect of a long and fulfilling life for each dog.',
  heroLink: 'Discover my breeding approach',
  labels: ['Foundation', 'Association', 'Breeding goals', 'Litter plans'],
  facts: ['Health & temperament', 'CDF / VDH', 'LUA & diversity', 'First litter · 2027'],
  introEyebrow: 'Schnüffler’s Dalmatians',
  introTitle: 'Thinking responsibly ahead.',
  introText: 'My breeding plans bring together LUA, transparent health data, genetic diversity and a temperament suited to everyday life. Pünktchen embodies these goals and provides the breeding foundation for the planned first litter.',
  dogEyebrow: 'Our dogs · foundation female',
  dogTitle: 'Pünktchen',
  dogText: 'Bacardi Feeling Canadian Amethyst comes from the Bacardi Feeling C-litter. She is LUA N/hu, genetically diverse and approved for breeding within CDF / VDH. Her open, sociable temperament is evident both in everyday life and in her gentle way with puppies and young dogs.',
  dogLink: 'Read Pünktchen’s full profile',
  futureEyebrow: 'Litter plans',
  futureTitle: 'Our first litter is planned for summer 2027.',
  futureText: 'Health, a suitable pairing and responsible preparation come first. Anyone wishing to learn about my breeding programme early is welcome to contact me without obligation.',
  futureLink: 'Read about our breeding plans',
  valuesEyebrow: 'What my breeding stands for',
  values: [
    ['Genetic diversity', 'LUA gene status, pedigree and the careful selection of every pairing are essential to responsible Dalmatian breeding for me.'],
    ['Temperament', 'I want to breed friendly, sociable and balanced Dalmatians who are dependable companions in everyday life.'],
    ['Quality of life', 'Exercise, enrichment and close family contact are, for me, the foundation of a balanced Dalmatian life.'],
  ],
};
---

<BaseLayout lang={lang} page="home" title={content.title} description={content.description}>
  <section class="hero">
    <Image
      src={heroImage}
      alt={lang === 'de' ? 'Pünktchen steht auf einer Bergwiese vor weitem Alpenpanorama' : 'Pünktchen standing in a mountain meadow before a wide Alpine panorama'}
      widths={[640, 960, 1440, 1920, 2560]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-content">
      <div>
        <p class="eyebrow">{content.heroEyebrow}</p>
        <h1>{content.heroTitle[0]} <span>{content.heroTitle[1]}</span></h1>
      </div>
      <div class="hero-side">
        <p>{content.heroText}</p>
        <a class="button-link" href={routes[lang].breeding}>{content.heroLink}</a>
      </div>
    </div>
  </section>

  <section class="fact-strip" aria-label={lang === 'de' ? 'Schnelle Fakten' : 'Key facts'}>
    {content.facts.map((fact, index) => (
      <div>
        <span class="fact-label">{content.labels[index]}</span>
        <strong>{fact}</strong>
      </div>
    ))}
  </section>

  <section class="editorial-section shell spot-field">
    <div class="section-index" aria-hidden="true">01</div>
    <div class="section-copy">
      <p class="eyebrow">{content.introEyebrow}</p>
      <h2>{content.introTitle}</h2>
      <p>{content.introText}</p>
      <a class="text-link" href={routes[lang].about}>{lang === 'de' ? 'Über mich und Schnüffler’s' : 'About me and Schnüffler’s'}</a>
    </div>
  </section>

  <section class="dog-feature">
    <div class="dog-feature-image">
      <Image
        src={standingImage}
        alt={lang === 'de' ? 'Pünktchen steht aufmerksam im grünen Feld' : 'Pünktchen standing attentively in a green field'}
        widths={[640, 900, 1200]}
        sizes="(max-width: 900px) 100vw, 55vw"
        format="avif"
      />
    </div>
    <div class="dog-feature-copy">
      <div>
        <p class="eyebrow">{content.dogEyebrow}</p>
        <h2>{content.dogTitle}</h2>
      </div>
      <div>
        <p>{content.dogText}</p>
        <a class="text-link" href={routes[lang].dog}>{content.dogLink}</a>
      </div>
    </div>
  </section>

  <section class="future-band">
    <div class="future-copy">
      <p class="eyebrow" style="color: currentColor">{content.futureEyebrow}</p>
      <h2>{content.futureTitle}</h2>
      <p>{content.futureText}</p>
      <a class="text-link" href={routes[lang].breeding}>{content.futureLink}</a>
    </div>
    <div class="future-year" aria-label="2027">2027</div>
  </section>

  <section>
    <div class="shell" style="padding-top: 4rem; padding-bottom: 2rem">
      <p class="eyebrow">{content.valuesEyebrow}</p>
    </div>
    <div class="values-grid">
      {content.values.map(([title, text], index) => (
        <article class="value-card">
          <span class="number">0{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
