---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import runningImage from '../assets/puenktchen-running.jpg';
import forestImage from '../assets/puenktchen-forest.jpg';
import { routes, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const links = {
  cLitter: 'https://www.bacardi-feeling.de/zucht-1/c-wurf/',
  lua: 'https://cdf-dalmatinerverein.de/lua-zuchtprogramm/',
};
const c = lang === 'de' ? {
  title: 'Über mich & Schnüffler’s | Verantwortungsvolle Dalmatinerzucht',
  description: 'Ich bin Cosima Grun. Bei Schnüffler’s verbinde ich LUA, Gesundheit, Wesen und genetische Vielfalt zu einer verantwortungsvollen Dalmatinerzucht.',
  eyebrow: 'Über mich & Schnüffler’s',
  heading: 'Mein Weg zur verantwortungsvollen Zucht.',
  lead: 'Solange ich denken kann, wünsche ich mir Dalmatiner an meiner Seite. Aus diesem Wunsch und einer klaren Vorstellung von Gesundheit, Wesen und Vielfalt entstand Schnüffler’s.',
  searchTitle: 'Eine Linie, die zu meiner Haltung passt.',
  searchText: ['Ich wollte meine Entscheidung nicht überstürzen. Deshalb suchte ich lange nach Züchtern, deren Vorstellungen zu meinen passten: freundliche, alltagstaugliche Dalmatiner, eine bewusste Zuchtplanung, genetische Vielfalt und das LUA-Gen.', 'Bei Bacardi Feeling fand ich diese Haltung. Pünktchen stammt aus dem außergewöhnlich erfolgreichen C-Wurf, in dem bis auf einen Hund alle Wurfgeschwister eine Zuchtzulassung erhielten. Die Zuchtstätte hat die LUA-Zucht im CDF entscheidend mit vorangebracht – ein Ziel, das auch meine künftigen Zuchtentscheidungen prägt.'],
  originLinks: ['Zum C-Wurf von Bacardi Feeling', 'Das LUA-Zuchtprogramm im CDF'],
  whyTitle: 'Die Grundlage meiner Zucht.',
  whyText: ['Pünktchen vereint ein offenes, freundliches Wesen mit robuster Gesundheit und hoher genetischer Vielfalt. Zu Hause ist sie ruhig, draußen bewegungsfreudig und im Umgang mit Welpen und Junghunden besonders liebevoll.', 'Diese Eigenschaften prägen die züchterische Grundlage von Schnüffler’s. Meine Zucht soll sich langfristig entwickeln und dabei stets demselben Anspruch folgen: gesunde, soziale und alltagstaugliche Dalmatiner verantwortungsvoll weiterzugeben.'],
  homeEyebrow: 'Leben mit Dalmatinern',
  homeTitle: 'Ein aktiver, gemeinsamer Alltag.',
  homeText: 'Zu unserem Alltag gehören große Felder, tägliche Bewegung und Kontakte zu anderen Hunden. Hier zeigt sich die Balance, die ich am Dalmatiner schätze: ruhig im Haus, ausdauernd und lebensfroh draußen.',
  cta: 'Meine Zuchtgedanken',
} : {
  title: 'About me & Schnüffler’s | Responsible Dalmatian breeding',
  description: 'I am Cosima Grun. At Schnüffler’s, I bring LUA, health, temperament and genetic diversity together in a responsible Dalmatian breeding programme.',
  eyebrow: 'About me & Schnüffler’s',
  heading: 'My path to responsible breeding.',
  lead: 'For as long as I can remember, I have wanted Dalmatians by my side. That wish, together with a clear vision of health, temperament and diversity, became Schnüffler’s.',
  searchTitle: 'A line that reflects my values.',
  searchText: ['I did not want to rush my decision. I searched carefully for breeders whose priorities matched my own: friendly Dalmatians suited to everyday life, thoughtful breeding decisions, genetic diversity and the LUA gene.', 'I found that approach at Bacardi Feeling. Pünktchen comes from its exceptionally successful C-litter, in which all but one sibling received breeding approval. The kennel has played an important role in advancing LUA breeding within CDF—an aim that will continue to shape my future breeding decisions.'],
  originLinks: ['Bacardi Feeling’s C-litter', 'The CDF LUA breeding programme'],
  whyTitle: 'The foundation of my breeding programme.',
  whyText: ['Pünktchen combines an open, friendly temperament with robust health and strong genetic diversity. She is calm at home, active outdoors and especially gentle with puppies and young dogs.', 'These qualities shape the breeding foundation of Schnüffler’s. My breeding programme is intended to grow over time while always following the same standard: responsibly raising healthy, sociable Dalmatians suited to everyday life.'],
  homeEyebrow: 'Life with Dalmatians',
  homeTitle: 'An active life together.',
  homeText: 'Our daily routine includes wide open fields, dependable exercise and time with other dogs. This is where I see the balance I value in Dalmatians: calm indoors, enduring and joyful outside.',
  cta: 'My breeding approach',
};
---

<BaseLayout lang={lang} page="about" title={c.title} description={c.description}>
  <PageIntro number="03" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />

  <section class="profile-grid">
    <div class="profile-image">
      <Image src={runningImage} alt={lang === 'de' ? 'Pünktchen läuft Cosima auf einem Feldweg entgegen' : 'Pünktchen running towards Cosima on a country path'} widths={[640, 960, 1440, 1920]} sizes="(max-width: 900px) 100vw, 60vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <div><p class="eyebrow">{c.homeEyebrow}</p><h2>{c.homeTitle}</h2></div>
      <p>{c.homeText}</p>
    </div>
  </section>

  <section class="body-grid shell">
    <h2>{c.searchTitle}</h2>
    <div class="body-copy">
      {c.searchText.map((p) => <p>{p}</p>)}
      <div class="link-row">
        <a class="text-link" href={links.cLitter} target="_blank" rel="noopener">{c.originLinks[0]}</a>
        <a class="text-link" href={links.lua} target="_blank" rel="noopener">{c.originLinks[1]}</a>
      </div>
    </div>
  </section>

  <section class="dog-feature">
    <div class="dog-feature-image">
      <Image src={forestImage} alt={lang === 'de' ? 'Porträt von Pünktchen im Wald' : 'Portrait of Pünktchen in the woods'} widths={[640, 900, 1200]} sizes="(max-width: 900px) 100vw, 55vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <h2>{c.whyTitle}</h2>
      <div>
        {c.whyText.map((p) => <p>{p}</p>)}
        <a class="text-link" href={routes[lang].breeding}>{c.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>
