---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import runningImage from '../assets/puenktchen-running.jpg';
import forestImage from '../assets/puenktchen-forest.jpg';
import { routes, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'de' ? {
  title: 'Über mich & Schnüffler’s | Dalmatinerzucht Hanau',
  description: 'Ich bin Cosima Grun. Mit meiner Dalmatinerhündin Pünktchen habe ich in Hanau den Grundstein für Schnüffler’s Dalmatiner gelegt.',
  eyebrow: 'Über mich & Schnüffler’s',
  heading: 'Mein Lebenstraum auf vier Pfoten.',
  lead: 'Solange ich denken kann, wünsche ich mir einen Dalmatiner. Aus diesem Wunsch entstand nach sorgfältiger Vorbereitung Schnüffler’s Dalmatiner.',
  searchTitle: 'Die lange Suche nach dem richtigen Hund.',
  searchText: ['Ich wollte meine Entscheidung nicht überstürzen. Deshalb suchte ich lange nach Züchtern, deren Vorstellungen zu meinen passten: freundliche, alltagstaugliche Dalmatiner, eine bewusste Zuchtplanung, genetische Vielfalt und das LUA-Gen.', 'Bei der Zuchtstätte Bacardi Feeling fand ich diese Haltung – und schließlich Pünktchen. Aus Bacardi Feeling Canadian Amethyst wurde ein fester Mittelpunkt meines Lebens.'],
  whyTitle: 'Warum züchten?',
  whyText: ['Pünktchen ist freundlich zu Menschen und anderen Hunden, zu Hause angenehm ruhig und draußen begeistert aktiv. Für mich vereint sie genau die Eigenschaften, die ich am Dalmatiner schätze.', 'Mit Schnüffler’s möchte ich diese Linie mit Sorgfalt fortführen. Mein Wunsch zu züchten beruht nicht allein auf Pünktchens Erscheinungsbild, sondern ebenso auf ihrem Wesen, ihrer Gesundheit und ihrer sozialen Art.'],
  homeTitle: 'Zu Hause in Hanau.',
  homeText: 'Zu unserem Alltag gehören die großen Felder in der Umgebung, tägliche Bewegung und Kontakte zu anderen Hunden. Hier erlebe ich Pünktchens Balance: ruhig im Haus, ausdauernd und lebensfroh draußen.',
  cta: 'Meine Zuchtgedanken',
} : {
  title: 'About me & Schnüffler’s | Dalmatian breeder in Hanau',
  description: 'I am Cosima Grun. Together with my Dalmatian Pünktchen, I laid the foundations for Schnüffler’s Dalmatians in Hanau, Germany.',
  eyebrow: 'About me & Schnüffler’s',
  heading: 'My lifelong dream on four paws.',
  lead: 'I had wanted a Dalmatian for as long as I could remember. Careful preparation turned that wish into Schnüffler’s Dalmatians.',
  searchTitle: 'A long search for the right dog.',
  searchText: ['I did not want to rush my decision. I searched carefully for breeders whose priorities matched my own: friendly Dalmatians suited to everyday life, thoughtful breeding decisions, genetic diversity and the LUA gene.', 'I found that approach at Bacardi Feeling – and ultimately found Pünktchen. Bacardi Feeling Canadian Amethyst soon became a central part of my life.'],
  whyTitle: 'Why breed?',
  whyText: ['Pünktchen is friendly with people and other dogs, pleasantly calm at home and enthusiastically active outdoors. For me, she brings together the qualities I value in a Dalmatian.', 'Through Schnüffler’s, I hope to continue this line with care. My wish to breed rests not only on Pünktchen’s appearance, but equally on her temperament, health and sociable nature.'],
  homeTitle: 'At home in Hanau.',
  homeText: 'Our daily life includes the wide local fields, dependable exercise and time with other dogs. This is where I see Pünktchen’s balance most clearly: calm indoors, enduring and joyful outside.',
  cta: 'My breeding approach',
};
---

<BaseLayout lang={lang} page="about" title={c.title} description={c.description}>
  <PageIntro number="03" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />

  <section class="profile-grid">
    <div class="profile-image">
      <Image src={runningImage} alt={lang === 'de' ? 'Pünktchen läuft Cosima auf einem Feldweg entgegen' : 'Pünktchen running towards Cosima on a country path'} widths={[640, 960, 1440, 1920]} sizes="(max-width: 900px) 100vw, 60vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <div><p class="eyebrow">Hanau · Hessen</p><h2>{c.homeTitle}</h2></div>
      <p>{c.homeText}</p>
    </div>
  </section>

  <section class="body-grid shell">
    <h2>{c.searchTitle}</h2>
    <div class="body-copy">{c.searchText.map((p) => <p>{p}</p>)}</div>
  </section>

  <section class="dog-feature">
    <div class="dog-feature-image">
      <Image src={forestImage} alt={lang === 'de' ? 'Porträt von Pünktchen im Wald' : 'Portrait of Pünktchen in the woods'} widths={[640, 900, 1200]} sizes="(max-width: 900px) 100vw, 55vw" format="avif" />
    </div>
    <div class="dog-feature-copy">
      <h2>{c.whyTitle}</h2>
      <div>
        {c.whyText.map((p) => <p>{p}</p>)}
        <a class="text-link" href={routes[lang].breeding}>{c.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>
