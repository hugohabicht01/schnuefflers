---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import { site, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'de' ? {
  title: 'Kontakt | Schnüffler’s Dalmatiner',
  description: 'Schreiben Sie mir zu Schnüffler’s Dalmatiner, meinen Hunden oder zum geplanten A-Wurf im Sommer 2027.',
  eyebrow: 'Kontakt',
  heading: 'Lernen wir uns kennen.',
  lead: 'Fragen zu Schnüffler’s, meinen Hunden oder zum geplanten A-Wurf im Sommer 2027 beantworte ich gern persönlich.',
  emailTitle: 'Schreiben Sie mir.',
  emailText: 'Am einfachsten erreichen Sie mich per E-Mail. Bitte erzählen Sie mir gern ein wenig von sich und davon, warum Sie sich für einen Dalmatiner interessieren.',
  instaTitle: 'Alltag bei Schnüffler’s.',
  instaText: 'Auf Instagram zeige ich Spaziergänge, Training, Ausflüge und das tägliche Leben mit meinen Hunden.',
  addressTitle: 'Persönliches Kennenlernen.',
  addressText: 'Persönliche Besuche vereinbare ich ausschließlich nach vorheriger Absprache.',
  external: 'Instagram öffnen',
} : {
  title: 'Contact | Schnüffler’s Dalmatians',
  description: 'Contact me about Schnüffler’s Dalmatians, my dogs or the first litter planned for summer 2027.',
  eyebrow: 'Contact',
  heading: 'Let’s get to know each other.',
  lead: 'I am happy to answer questions about Schnüffler’s, my dogs or the first litter planned for summer 2027.',
  emailTitle: 'Write to me.',
  emailText: 'Email is the easiest way to reach me. You are welcome to share a little about yourself and why you are interested in a Dalmatian.',
  instaTitle: 'Everyday life at Schnüffler’s.',
  instaText: 'On Instagram, I share walks, training, outings and daily life with my dogs.',
  addressTitle: 'Meet in person.',
  addressText: 'I arrange personal visits by prior appointment only.',
  external: 'Open Instagram',
};
---

<BaseLayout lang={lang} page="contact" title={c.title} description={c.description}>
  <PageIntro number="05" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />
  <section class="contact-grid">
    <div class="contact-panel">
      <p class="eyebrow">E-Mail</p>
      <h2>{c.emailTitle}</h2>
      <p>{c.emailText}</p>
      <a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="contact-panel">
      <p class="eyebrow">Instagram</p>
      <h2>{c.instaTitle}</h2>
      <p>{c.instaText}</p>
      <a class="contact-link" href={site.instagram} target="_blank" rel="me noopener">@miss_pointfluencer</a>
      <span class="fact-label">{c.external}</span>
    </div>
  </section>
  <section class="body-grid shell">
    <h2>{c.addressTitle}</h2>
    <div class="body-copy">
      <p>{c.addressText}</p>
      <address style="font-style: normal; font-size: 1.25rem">
        {site.owner}<br />
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}<br />
        {site.address.country}
      </address>
    </div>
  </section>
</BaseLayout>
