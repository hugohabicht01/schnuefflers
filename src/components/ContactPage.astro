---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from './PageIntro.astro';
import { site, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === 'de' ? {
  title: 'Kontakt | Schnüffler’s Dalmatiner Hanau',
  description: 'Schreiben Sie mir zu Pünktchen, Schnüffler’s Dalmatiner in Hanau oder zu meinem geplanten A-Wurf im Sommer 2027.',
  eyebrow: 'Kontakt',
  heading: 'Lernen wir uns kennen.',
  lead: 'Fragen zu Pünktchen, Schnüffler’s oder meinem geplanten A-Wurf im Sommer 2027 beantworte ich gern persönlich.',
  emailTitle: 'Schreiben Sie mir.',
  emailText: 'Am einfachsten erreichen Sie mich per E-Mail. Bitte erzählen Sie mir gern ein wenig von sich und davon, warum Sie sich für einen Dalmatiner interessieren.',
  instaTitle: 'Pünktchens Alltag.',
  instaText: 'Auf Instagram gibt es laufend neue Einblicke in Spaziergänge, Training, Ausflüge und das tägliche Leben mit Pünktchen.',
  addressTitle: 'Schnüffler’s in Hanau.',
  addressText: 'Persönliche Besuche vereinbare ich ausschließlich nach vorheriger Absprache.',
  external: 'Instagram öffnen',
} : {
  title: 'Contact | Schnüffler’s Dalmatians Hanau',
  description: 'Contact me about Pünktchen, Schnüffler’s Dalmatians in Hanau or my first litter planned for summer 2027.',
  eyebrow: 'Contact',
  heading: 'Let’s get to know each other.',
  lead: 'I am happy to answer questions about Pünktchen, Schnüffler’s or my first litter planned for summer 2027.',
  emailTitle: 'Write to me.',
  emailText: 'Email is the easiest way to reach me. You are welcome to share a little about yourself and why you are interested in a Dalmatian.',
  instaTitle: 'Pünktchen’s everyday life.',
  instaText: 'Instagram offers regular glimpses of Pünktchen’s walks, training, outings and daily life.',
  addressTitle: 'Schnüffler’s in Hanau.',
  addressText: 'I arrange personal visits by prior appointment only.',
  external: 'Open Instagram',
};
---

<BaseLayout lang={lang} page="contact" title={c.title} description={c.description}>
  <PageIntro number="05" eyebrow={c.eyebrow} title={c.heading} lead={c.lead} />
  <section class="contact-grid">
    <div class="contact-panel">
      <p class="eyebrow">E-Mail</p>
      <h2>{c.emailTitle}</h2>
      <p>{c.emailText}</p>
      <a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="contact-panel">
      <p class="eyebrow">Instagram</p>
      <h2>{c.instaTitle}</h2>
      <p>{c.instaText}</p>
      <a class="contact-link" href={site.instagram} target="_blank" rel="me noopener">@miss_pointfluencer</a>
      <span class="fact-label">{c.external}</span>
    </div>
  </section>
  <section class="body-grid shell">
    <h2>{c.addressTitle}</h2>
    <div class="body-copy">
      <p>{c.addressText}</p>
      <address style="font-style: normal; font-size: 1.25rem">
        {site.owner}<br />
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}<br />
        {site.address.country}
      </address>
    </div>
  </section>
</BaseLayout>
