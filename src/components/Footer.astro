---
import { routes, site, ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = ui[lang];
---

<footer class="site-footer">
  <div class="footer-main">
    <p class="footer-name">Schnüffler’s<br />Dalmatiner</p>
    <p>{copy.footerLine}</p>
    <div class="footer-links">
      <a href={`mailto:${site.email}`}>{copy.email}</a>
      <a href={site.instagram} rel="me noopener" target="_blank">{copy.instagram}</a>
      <a href={routes[lang].legal}>{copy.legal}</a>
      <a href={routes[lang].privacy}>{copy.privacy}</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {site.owner}</span>
    <span>schnuefflers.de</span>
  </div>
</footer>
